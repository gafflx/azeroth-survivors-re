+/// The most enemy damage numbers kept on screen at once. Each costs a text layout and an overlap
+/// solve every frame, and a late-run crowd sends ~80 a second (~125 alive at once, up to ~360);
+/// past this, plain hits go unshown. Crits, the hero's own numbers and heals always show.
+/// See docs/performance/M2_RESULTS.md.
+pub(super) const MAX_DAMAGE_NUMBERS: usize = 64;
+
+/// How long a number floats: the engine's combat-text duration (`combat_text` categories 0 and 2).
+const NUMBER_SECS: f64 = 1.5;
+
+/// When each enemy damage number still on screen was shown, for [`MAX_DAMAGE_NUMBERS`].
+#[derive(Resource, Default)]
+pub(super) struct NumberBudget(std::collections::VecDeque<f64>);
+
+impl NumberBudget {
+    /// Whether a number shown at `now` (the game clock the engine ages numbers by) fits: a crit
+    /// always does, a plain hit only below the cap. An admitted number is counted either way.
+    pub fn admit(&mut self, now: f64, crit: bool) -> bool {
+        while self.0.front().is_some_and(|&t| now - t >= NUMBER_SECS) {
+            self.0.pop_front();
+        }
+        if !crit && self.0.len() >= MAX_DAMAGE_NUMBERS {
+            return false;
+        }
+        self.0.push_back(now);
+        true
+    }
+}
